# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# LOCAL DEV: run `supabase start` and copy the printed "API URL" + "anon key"
# + "service_role key" here. PRODUCTION: Settings → API in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE ROLE KEY — server-only, NEVER prefix with NEXT_PUBLIC_, NEVER import
# in a Client Component. Only `src/lib/supabase/admin.ts` (Storage operations)
# reads this. It bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used by metadataBase / absolute URLs. Canonical production
# origin, no trailing slash. Preview deploys can override per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Playwright (only required for `pnpm test:e2e`)
# ----------------------------------------------------------------------------
# Point at a DEDICATED TEST stack (local `supabase start` or a test project) —
# never production. See tests/e2e/README.md for the one-time host bootstrap.
#
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_HOST_EMAIL=host@test.local
# PLAYWRIGHT_HOST_PASSWORD=
# PLAYWRIGHT_SUPABASE_SERVICE_KEY=   # service_role key of the TEST stack
