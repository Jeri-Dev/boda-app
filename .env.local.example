# ----------------------------------------------------------------------------
# Database (Drizzle + libSQL)
# ----------------------------------------------------------------------------
# DEV: a local SQLite file (created on first `pnpm db:migrate`).
# PROD (serverless): a remote libSQL/Turso URL — same code, only the value
# changes. Server-only; NEVER prefix with NEXT_PUBLIC_.
DATABASE_URL=file:local.db

# Auth token for the remote libSQL/Turso database. Leave EMPTY in dev (file:
# URLs need no token). Generate with `turso db tokens create <db>` for prod and
# set it in the host's environment variables (Production). Secret.
DATABASE_AUTH_TOKEN=

# Public site URL — used by metadataBase / absolute URLs. Canonical production
# origin, no trailing slash. Preview deploys can override per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Playwright (only required for `pnpm test:e2e`)
# ----------------------------------------------------------------------------
# PLAYWRIGHT_BASE_URL=http://localhost:3000
