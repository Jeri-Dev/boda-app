# ----------------------------------------------------------------------------
# Database — Supabase Postgres (Drizzle + postgres.js)
# ----------------------------------------------------------------------------
# The browser NEVER talks to Supabase: all access is server-side via Drizzle.
# This is a Postgres connection string. Server-only — NEVER prefix NEXT_PUBLIC_.
#
# Get it from Supabase -> Project -> Connect:
#   * PROD (Netlify serverless): the TRANSACTION pooler (port 6543). Required for
#     serverless — the client sets `prepare: false` for it. Example:
#       postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   * DEV: the SESSION pooler (port 5432) or a direct connection is fine.
#
# Apply migrations OUT OF BAND (never from the running app) against a DIRECT or
# session-pooler URL (the migration also enables RLS, so use `db:migrate` — which
# runs the SQL file — not `db:push`, which diffs from the schema and skips it).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Public site URL — used by metadataBase / absolute URLs. Canonical production
# origin, no trailing slash. Preview deploys can override per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Back-office protection (Netlify edge function netlify/edge-functions/basic-auth)
# ----------------------------------------------------------------------------
# The app is OPEN (no login), so this Basic-Auth gate is the only thing guarding
# the host PII. Set BOTH in Netlify (Functions scope) for production. The guest
# RSVP surface (/i/..., /info, /~offline) stays public. If unset, the gate fails
# CLOSED (denies the back-office). Not needed for local `pnpm dev`.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ----------------------------------------------------------------------------
# Playwright (only required for `pnpm test:e2e`)
# ----------------------------------------------------------------------------
# Point DATABASE_URL at a disposable Postgres; the specs truncate tables.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
